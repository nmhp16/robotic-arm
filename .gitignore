# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Virtual envs
venv/
.venv/
env/

# IDEs
.vscode/
.idea/

# Generated data + checkpoints. Leading `/` anchors these to the repo root
# so they don't also swallow `src/arm_act/data/` etc.
/data/
/checkpoints/
/wandb/
/outputs/
/eval/runs/
*.hdf5
*.tfrecord

# OS
.DS_Store
Thumbs.db

/media/

# Generated robot assets — only the *.urdf.xacro source is committed.
# Regenerate via: xacro <name>.urdf.xacro -o <name>.urdf
#                 ./scripts/convert_ur5_simple_gripper.py
/assets/**/*.usd
/assets/**/*.urdf
/assets/**/configuration/
/assets/**/config.yaml
/assets/**/.asset_hash