# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Virtual envs
venv/
.venv/
env/

# IDEs
.vscode/
.idea/

# Generated data + checkpoints. Leading `/` anchors these to the repo root
# so they don't also swallow `src/arm_act/data/` etc.
/data/
/checkpoints/
/wandb/
/outputs/
/eval/runs/
*.hdf5
*.tfrecord

# OS
.DS_Store
Thumbs.db

# FUSE / Nucleus filesystem writeback temp files. Appear when an open
# file is replaced (USD conversion, settings rewrites). Always tiny,
# always safe to delete, never useful to commit.
.fuse_hidden*

# Claude Code per-machine state: schedule lock, local permission overrides,
# session memory. Personal to each clone; shouldn't be committed.
.claude/

/media/

# Generated robot assets. Hand-authored URDFs are the source-of-truth (no
# xacro indirection) and ARE committed; everything the URDF -> USD
# converter produces is regenerated locally and stays out of the tree.
/assets/**/*.usd
/assets/**/*.urdf
/assets/t3_401_simple_gripper/t3_401_simple_gripper.urdf
/assets/ur5_omnipicker/ur5_omnipicker.urdf
/assets/holder/holder.urdf
/assets/wide_vial/wide_vial.urdf
/assets/**/configuration/
/assets/**/config.yaml
/assets/**/.asset_hash

# Generated demo videos (large binaries; regenerate via oracle.sh /
# smoke.sh with --video-out).
/docs/videos/

*.png
graphify-out