# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Virtual envs
venv/
.venv/
env/

# IDEs
.vscode/
.idea/

# Generated data + checkpoints. Leading `/` anchors these to the repo root
# so they don't also swallow `src/arm_act/data/` etc.
/data/
/checkpoints/
/wandb/
/outputs/
/eval/runs/
*.hdf5
*.tfrecord

# OS
.DS_Store
Thumbs.db

/media/

# Generated robot assets. The hand-written t3_401_simple_gripper.urdf is
# the source-of-truth (no xacro indirection) and IS committed; everything
# the URDF -> USD converter produces is regenerated locally.
/assets/**/*.usd
/assets/**/*.urdf
!/assets/t3_401_simple_gripper/t3_401_simple_gripper.urdf
/assets/**/configuration/
/assets/**/config.yaml
/assets/**/.asset_hash

# Generated demo videos (large binaries; regenerate via oracle.sh /
# smoke.sh with --video-out).
/docs/videos/